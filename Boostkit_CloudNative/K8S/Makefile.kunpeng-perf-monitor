# Kunpeng Performance Monitor Makefile

# Project configuration
PROJECT_NAME := kunpeng-perf-monitor
VERSION ?= 1.0
BUILD_TIME := $(shell date -u '+%Y-%m-%d_%H:%M:%S')
GIT_COMMIT := $(shell git rev-parse HEAD)

# Build configuration
GOPATH_BIN := $(shell go env GOPATH)/bin
BUILD_DIR := bin
DOCKER_IMAGE := kunpeng-perf-monitor:$(VERSION)

# Build flags
LDFLAGS=-ldflags "-s -w"


# Setting SHELL to bash allows bash commands to be executed by recipes.
SHELL = /usr/bin/env bash -o pipefail
.SHELLFLAGS = -ec

.PHONY: all
all: build

##@ General

.PHONY: help
help: ## Display this help.
	@echo "Kunpeng Performance Monitor Build System"
	@echo ""
	@awk 'BEGIN {FS = ":.*##"; printf "Usage:\n  make \033[36m<target>\033[0m\n"} /^[a-zA-Z_0-9-]+:.*?##/ { printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2 } /^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) } ' $(MAKEFILE_LIST)

.PHONY: version
version: ## Show version information.
	@echo "Project: $(PROJECT_NAME)"
	@echo "Version: $(VERSION)"
	@echo "Build Time: $(BUILD_TIME)"
	@echo "Git Commit: $(GIT_COMMIT)"

##@ Development

.PHONY: deps
deps: ## Download dependencies.
	@echo "Downloading dependencies..."
	bash libkperf.sh get_libkperf_ready $(CURDIR)
	go get -d -v ./cmd/kunpeng-perf-monitor ./pkg/kunpeng-perf-monitor/...
	@echo "Dependencies downloaded"

.PHONY: fmt
fmt: ## Format code.
	@echo "Formatting code..."
	go fmt ./cmd/kunpeng-perf-monitor ./pkg/kunpeng-perf-monitor/...
	@echo "Code formatted"

.PHONY: vet
vet: ## Run go vet.
	@echo "Running go vet..."
	go vet ./cmd/kunpeng-perf-monitor ./pkg/kunpeng-perf-monitor/...
	@echo "Go vet completed"

.PHONY: test
test: deps ## Run tests.
	@echo "Running tests..."
	LD_LIBRARY_PATH=$(CURDIR)/pkg/kunpeng-perf-monitor/libkperf/lib:$$LD_LIBRARY_PATH \
	go test ./pkg/kunpeng-perf-monitor/collector/... -v
	@echo "Tests completed"

.PHONY: tidy
tidy: ## Tidy go modules.
	@echo "Tidying go modules..."
	go mod tidy
	@echo "Go mod tidy completed"

##@ Build

.PHONY: build
build: deps ## Build the project.
	@echo "Building $(PROJECT_NAME)..."
	@mkdir -p $(BUILD_DIR)
	CGO_ENABLED=1 go build $(LDFLAGS) -o $(BUILD_DIR)/kunpeng-perf-monitor ./cmd/kunpeng-perf-monitor
	@echo "$(PROJECT_NAME) built successfully"
	@echo "Binary installed to $(BUILD_DIR)/kunpeng-perf-monitor"

.PHONY: build-local
build-local: deps ## Build binary to local bin directory.
	@echo "Building $(PROJECT_NAME) locally..."
	@mkdir -p $(BUILD_DIR)
	CGO_ENABLED=1 go build $(LDFLAGS) -o $(BUILD_DIR)/kunpeng-perf-monitor ./cmd/kunpeng-perf-monitor
	@echo "$(PROJECT_NAME) built locally in $(BUILD_DIR)/kunpeng-perf-monitor"

.PHONY: clean
clean: ## Clean build artifacts.
	@echo "Cleaning $(PROJECT_NAME)..."
	# rm -f $(GOPATH_BIN)/kunpeng-perf-monitor
	bash libkperf.sh rm_libkperf_files $(CURDIR)
	rm -rf $(BUILD_DIR)
	@echo "Clean completed"

##@ Docker

.PHONY: docker-build
docker-build: ## Build docker image.
	@echo "Building docker image $(DOCKER_IMAGE)..."
	sudo docker build --force-rm -f ./Dockerfile.kunpeng-perf-monitor -t $(DOCKER_IMAGE) .
	@echo "Docker image $(DOCKER_IMAGE) built successfully"

.PHONY: docker-push
docker-push: ## Push docker image.
	@echo "Pushing docker image $(DOCKER_IMAGE)..."
	sudo docker push $(DOCKER_IMAGE)
	@echo "Docker image pushed"

.PHONY: docker-run
docker-run: ## Run docker container.
	@echo "Running docker container..."
	sudo docker run --rm -it $(DOCKER_IMAGE)

.PHONY: docker-clean
docker-clean: ## Clean docker images.
	@echo "Cleaning docker images..."
	-sudo docker rmi $(DOCKER_IMAGE)
	@echo "Docker images cleaned"

##@ Installation

.PHONY: install
install: build ## Install binary to system.
	@echo "Installing $(PROJECT_NAME) to system..."
	sudo cp $(BUILD_DIR)/kunpeng-perf-monitor /usr/local/bin/
	sudo chmod +x /usr/local/bin/kunpeng-perf-monitor
	@echo "Installation completed"

.PHONY: uninstall
uninstall: ## Uninstall binary from system.
	@echo "Uninstalling $(PROJECT_NAME) from system..."
	sudo rm -f /usr/local/bin/kunpeng-perf-monitor
	@echo "Uninstallation completed"

##@ Development Tools

.PHONY: run
run: build-local ## Run the application locally.
	@echo "Running $(PROJECT_NAME)..."
	./$(BUILD_DIR)/kunpeng-perf-monitor

.PHONY: check
check: fmt vet test ## Run all checks (format, vet, test).
	@echo "All checks passed"

.PHONY: ci
ci: check build ## Run CI pipeline.
	@echo "CI pipeline completed successfully"